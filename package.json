{
  "name": "nanosearch-js",
  "version": "1.0.0",
  "description": "A tiny, super-fast, hybrid search engine for browser, server, and edge runtimes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "bench": "node scripts/bench.js"
  },
  "author": "NanoSearch Contributors",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "keywords": [
    "search",
    "vector-search",
    "bm25",
    "hybrid-search",
    "typo-tolerance",
    "edge",
    "in-memory"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
